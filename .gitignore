# Explicit project allowlist: local recovery trees, tools, archives and keys stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/docs/
!/scripts/
!/references/
!/evidence/
!/android-app/
!/character-prototype/
!/editor/

/character-prototype/*
!/character-prototype/preview/
!/character-prototype/serve_preview.py
!/character-prototype/README.md
/character-prototype/preview/*.webm
!/character-prototype/preview/motion-preview-v1.webm
/references/original-manifest.json
/android-app/.gradle/
/android-app/**/build/
/android-app/local.properties
/android-app/signing/
/android-app/signing.properties
/android-app/verification/
**/__pycache__/
**/*.pyc
**/*.keystore
**/*.jks
**/*.p12
**/*.pem
**/*.key
**/.env
**/.env.*
**/*.log
**/hs_err_pid*
**/*.bak*
**/node_modules/
!android-app/gradle/wrapper/gradle-wrapper.jar
