# Explicit project allowlist: local recovery trees, tools, archives and keys stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/docs/
!/scripts/
!/references/
!/evidence/
!/android-app/
!/character-prototype/

/character-prototype/*
!/character-prototype/preview/
!/character-prototype/serve_preview.py
!/character-prototype/README.md
/character-prototype/preview/*.webm
!/character-prototype/preview/motion-preview-v1.webm
/references/original-manifest.json
/android-app/.gradle/
/android-app/**/build/
/android-app/local.properties
/android-app/signing/
/android-app/signing.properties
/android-app/verification/
**/__pycache__/
**/*.pyc
**/*.keystore
**/*.jks
**/*.p12
**/*.pem
**/*.key
**/.env
**/.env.*
**/*.log
**/hs_err_pid*
**/*.bak*
**/node_modules/
!android-app/gradle/wrapper/gradle-wrapper.jar

# Incremental Work validation and regression sources
!/tests/
!/validation/
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/publish-signed-057.yml
/validation/*.log
/validation/*.apk

# Rendered previews are delivered separately; regenerate with tests/render_gles.py.
/validation/*.png
/validation/*.mp4

# Recreated by the deterministic response checks.
/validation/motion-0.5.*.csv
